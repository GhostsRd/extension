{
  "name": "History Tracker",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "activeTab",
    "history",
    "alarms",
    "storage"
  ],
  "host_permissions": [
     "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
  "default_title": "Extension"
  
}
}